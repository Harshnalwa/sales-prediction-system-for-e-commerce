# Comma-separated frontend origins allowed to call the API.
# Keep the local Vite origins enabled automatically.
FRONTEND_ORIGINS=https://your-frontend.vercel.app

# Optional: direct, trusted download URL for the trained joblib artifact.
# Upload backend/models/random_forest_model.pkl to private object storage and
# use a time-limited signed URL. Never use an artifact from an unknown source.
MODEL_ARTIFACT_URL=

# Optional: path to a mounted/persistent model file. Defaults to backend/models/.
# MODEL_PATH=/var/data/random_forest_model.pkl
