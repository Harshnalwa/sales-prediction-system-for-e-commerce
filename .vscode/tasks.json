{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: install + run API",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt && python -m uvicorn main:app --reload",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: install + run",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Train model (run pipeline)",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt && python run_pipeline.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Start App (backend + frontend)",
      "dependsOn": ["Backend: install + run API", "Frontend: install + run"],
      "problemMatcher": []
    }
  ]
}
